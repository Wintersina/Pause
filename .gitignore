# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data (only ignore for folders Unity ignores)
!/Pause/[Aa]ssets/**/*.meta

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS
.DS_Store

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Signing keys - do not commit
*.keystore
*.jks

# Unity build output
Builds/

# Claude Code local state (project skills are shared and tracked)
.claude/*
!.claude/skills/

# Python caches from art generators
__pycache__/
*.pyc

# Atom art: only the generator is tracked (PickupArt.cs names it)
Pause/Assets/Art/Atoms/src~/*
!Pause/Assets/Art/Atoms/src~/pixel_atoms.py

# Generated SVG intermediates. Each is re-written by the tracked generator
# next to it (bosses.py, weapons.py/fx.py, Enemies build.py, Worlds <world>.py
# and walls.py, Codex make_art.py, build_icons.py, build_pause.py), so only
# the generators and the PNGs they render are tracked. Hand-authored SVG
# sources (Shield, UI/DeathPanel, UI/Dock, UI/Hud, UI/Tutorial) stay tracked.
Pause/Assets/Art/Bosses/src~/*.svg
Pause/Assets/Art/Bosses/*/src~/*.svg
Pause/Assets/Art/Weapons/*/src~/*.svg
Pause/Assets/Art/Weapons/*/src~/fx/*.svg
Pause/Assets/Art/Enemies/src~/svg/
Pause/Assets/Art/Worlds/*/src~/svg/
Pause/Assets/Art/Worlds/src~/walls/
Pause/Assets/Art/UI/Codex/src~/*.svg
Pause/Assets/Art/UI/Icons/src~/*.svg
Pause/Assets/Art/UI/Pause/src~/*.svg

# Personal question list (local only)
QUESTIONS.md

# Secrets
.env
.env.*

<?xml version="1.0" encoding="utf-8"?>
<!-- The Firebase Unity SDK drags firebase-analytics in as a dependency; Pause uses only Auth, Firestore and
     App Check, so Analytics collection stays off (Play Data safety: no analytics, no ad id from Firebase). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="me.hapticgate.pause.firebaseprivacy"
    android:versionCode="1"
    android:versionName="1.0" >
    <application>
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
    </application>
</manifest>

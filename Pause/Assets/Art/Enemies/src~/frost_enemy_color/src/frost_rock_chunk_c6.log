+                nr, ng, nb = rgb(0.12, 0.38, min(0.96, 0.58 + lum * 0.42))
+        elif b > r * 1.22 and g > r * 1.10 and b > 100:
+            # Existing cyan/ice pixels: retain cold energy, shift toward
+            # the approved cyan-white crystal family.
+            if g > 170 and b > 180 and r < 125:
+                nr, ng, nb = rgb(0.52, 0.88, min(1.0, 0.42 + lum * 0.72))
+            else:
+                nr, ng, nb = rgb(0.56, min(0.78, s + 0.10), min(1.0, 0.48 + lum * 0.65))
+        elif lum > 0.58:
+            # Glacier crust and hit effects: white with a restrained blue cast.
+            nr, ng, nb = rgb(0.56, min(0.34, s * 0.55), min(1.0, 0.70 + lum * 0.30))
+        else:
+            # Basalt plates: blue-black rather than neutral/brown darks.
+            nr, ng, nb = rgb(0.61, min(0.66, max(0.20, s * 1.25)), min(0.70, 0.08 + lum * 0.72))
+        px[x, y] = (nr, ng, nb, a)
+
+im.save(dst, "PNG")


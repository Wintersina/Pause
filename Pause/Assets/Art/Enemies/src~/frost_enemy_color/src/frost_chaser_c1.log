from PIL import Image
import colorsys, math
src=Image.open('frost_chaser_c1_in.png').convert('RGBA')
out=[]
for y in range(src.height):
  for x in range(src.width):
    r,g,b,a=src.getpixel((x,y))
    if a==0:
      out.append((0,0,0,0)); continue
    mx=max(r,g,b); mn=min(r,g,b); v=mx/255.0; s=0 if mx==0 else (mx-mn)/mx
    h=colorsys.rgb_to_hsv(r/255,g/255,b/255)[0]*360 if mx else 0
    # detect the central energy core by position and cyan/blue coloration
    core=(285 <= x <= 420 and 350 <= y <= 475 and b >= r*1.15 and g >= r*1.05)
    if core:
      # sun-gold core/flame
      t=v
      if t<.18: c=(63,31,8)
      elif t<.38: c=(128,60,7)
      elif t<.62: c=(207,116,9)
      elif t<.82: c=(247,179,24)
      else: c=(255,238,142)
    elif 8 <= h <= 55 and s>.16:
      # bronze -> sun-gold / amber hardware
      if v<.18: c=(60,30,10)
      elif v<.36: c=(112,55,11)
      elif v<.58: c=(173,85,10)
      elif v<.78: c=(225,139,19)
      else: c=(255,202,72)
    elif (h>=155 or h<=255) and s>.18:
      # blue/cyan pixels: dark structure becomes cobalt, brighter facets become ice armour
      if v<.18: c=(8,18,43)
      elif v<.32: c=(12,35,78)
      elif v<.48: c=(26,68,132)
      elif v<.66: c=(82,136,196)
      elif v<.82: c=(165,199,226)
      else: c=(241,242,231)
    elif s<.22:
      # neutral metal -> chrome/bone silver, preserving shading
      if v<.16: c=(24,30,39)
      elif v<.32: c=(58,68,80)
      elif v<.52: c=(111,123,137)
      elif v<.72: c=(181,190,194)
      else: c=(239,239,229)
    else:
      # dark painted structure and residual warm pixels -> navy/gold-leaning metal
      if v<.22: c=(12,20,38)
      elif v<.42: c=(20,36,66)
      elif v<.64: c=(48,67,96)
      else: c=(156,170,182)
    out.append((*c,a))
Image.new('RGBA',src.size).putdata(out)
res=Image.new('RGBA',src.size); res.putdata(out); res.save('frost_chaser_c1_new.png')

+    p = rgb.astype(np.int16)
+    r, g, b = p[..., 0], p[..., 1], p[..., 2]
+    magenta = (
+        (r + b >= 4)
+        & (r > g * 1.35)
+        & (b > r * 0.55)
+        & (b < r * 1.8)
+        & ((np.maximum.reduce([r, g, b]) - np.minimum.reduce([r, g, b])) > np.maximum.reduce([r, g, b]) * 0.38)
+        & (np.maximum(r, b) < 180)
+    )
+    return bool(np.any(magenta))
+
+
+def main() -> int:
+    failures: list[str] = []
+    changed_values: list[float] = []
+    for state in range(3):

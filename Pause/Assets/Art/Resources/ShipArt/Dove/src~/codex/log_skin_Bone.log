+        if not candidate.exists():
+            raise SystemExit(f"missing generated candidate: {candidate}")
+        count = build(ref, candidate, output)
+        print(f"{output.name}: changed native pixels = {count}")
+
+
+if __name__ == "__main__":
+    main()
